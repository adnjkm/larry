{
  "name": "larry",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:web": "vite --host",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "kits": "node --env-file-if-exists=.env scripts/generate-kits.ts",
    "compare": "node scripts/compare.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.323",
