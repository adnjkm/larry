      "name": "Retraction",
      "does": "Each click sends the tip out or tucks it away.",
      "words": {
        "part": "the refill",
        "button": "the button"
      },
      "tips": {
        "spring": [
          "A spring only pushes back while something squeezes it.",
          "Look for a ledge it sits on, and a collar that comes down on it.",
          "The collar only squeezes the spring when the tip goes out."
        ],
        "cam": [
          "The rod rises only when a bump on the cam is under it.",
          "This cam has two bumps, opposite each other.",
          "A click that lands on a bump leaves the tip out. The next click has to land between bumps."
        ]
      }
    },
    {
      "entry": "ball-tip",
      "name": "Ball tip",
      "does": "The ball rolls and lays ink onto the paper.",
      "words": {
        "fluid": "the ink",
        "surface": "the paper"
      },
      "tips": {
        "ball": [
          "The ball can only roll if it touches the paper.",
          "It also has to sit where the ink reaches it from behind."
        ]
      }
    }
  ]
