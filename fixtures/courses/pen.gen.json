  "mechanisms": [
    {
      "entry": "click-latch",
      "name": "Retraction",
      "does": "Each click sends the tip out or back.",
      "words": {
        "part": "the tip",
        "button": "the button"
      },
      "tips": {
        "spring": [
          "A spring pushes the tip back as soon as nothing holds it.",
          "Look for the ledge inside the nose, and the collar on the refill.",
          "The collar moves down toward the ledge when the tip goes out."
        ],
        "cam": [
          "A cam turns each push into a step, so the tip is held or freed.",
          "Look at the two bumps on the rim, opposite each other.",
          "The rod rises only while a bump sits under it."
        ]
      }
    },
    {
      "entry": "ball-tip",
      "name": "Ball tip",
      "does": "The ball lays ink, and plugs when still.",
      "words": {
        "fluid": "the ink",
        "surface": "the paper"
      },
      "tips": {
        "ball": [
          "A ball that fits its socket closely lets only a thin film past.",
          "Watch the ink come down the refill from behind the tip.",
          "The paper lies below the tip, and the ball rolls across it."
        ]
      }
    }
  ]
